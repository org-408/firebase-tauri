{
  "name": "firebase-tauri-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Tauri 2 plugins for Firebase Analytics and Crashlytics: ports of @capacitor-firebase/analytics and crashlytics",
  "license": "MIT AND Apache-2.0",
  "type": "module",
  "workspaces": [
    "crates/tauri-plugin-firebase-analytics",
    "crates/tauri-plugin-firebase-crashlytics"
  ],
  "scripts": {
    "build": "npm run build -w tauri-plugin-firebase-analytics-api -w tauri-plugin-firebase-crashlytics-api",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run build && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@capacitor-firebase/analytics": "8.6.0",
    "@capacitor-firebase/crashlytics": "8.6.0",
    "@capacitor/core": "^8.0.0",
    "@tauri-apps/api": "^2.12.4",
    "@types/node": "^24.10.1",
    "firebase": "^12.6.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
